# Local Development Toggle (true = use DuckDB parquet mock, false = use real AWS Athena)
LOCAL_DEV=true

# Bedrock Model configuration (Nova Pro, Claude Sonnet, Claude Opus)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
MOCK_LLM=false

# AWS Regional configuration (where Bedrock & Athena are running)
AWS_DEFAULT_REGION=us-east-1
ATHENA_DATABASE=analytics_db
ATHENA_S3_OUTPUT=s3://my-athena-query-results-bucket/uncategorized/

# Security Settings
REQUIRE_AUTH=false
JWT_SECRET=super-secret-enterprise-key-do-not-share-12345

# Database URL (Used by FastAPI backend)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Langfuse Observability Keys
LANGFUSE_PUBLIC_KEY=pk-lf-12345
LANGFUSE_SECRET_KEY=sk-lf-12345
LANGFUSE_HOST=http://localhost:3000
